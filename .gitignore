# Unreal Engine 5 project. Based on github/gitignore UnrealEngine.gitignore.
# Everything here is regenerated by the editor or the build, so it stays out of git.

# Engine-generated folders (recreated on first build / editor launch)
/Binaries/
/Intermediate/
/DerivedDataCache/
/Saved/
Plugins/**/Binaries/
Plugins/**/Intermediate/

# Crash dumps, wherever they land
*.dmp

# IDE and project files (regenerate with: right-click Pantheon.uproject > Generate Visual Studio project files)
.vs/
.idea/
.vscode/
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
*.xcodeproj
*.xcworkspace

# Compiled object files, precompiled headers and libraries
*.slo
*.lo
*.o
*.obj
*.gch
*.pch
*.so
*.dylib
*.dll
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# Packaged builds (keep per-platform PakBlacklist files and icons)
Build/*
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt
!Build/**/*.ico

# Local-only config layers (Unreal loads Config/User*.ini after Default*.ini).
# EOS client credentials live in Config/UserEngine.ini (see README > Setup).
/Config/User*.ini
